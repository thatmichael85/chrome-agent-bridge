{
  "manifest_version": 3,
  "name": "Chrome Agent Bridge",
  "version": "1.0.0",
  "description": "Lets local MCP agents (Claude Code, Codex) control this browser via a local relay. No debug port.",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Chrome Agent Bridge"
  },
  "key": ""
}
